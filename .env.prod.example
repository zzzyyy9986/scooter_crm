# Скопируйте в .env на сервере: cp .env.prod.example .env

# Публичный URL приложения (IP или домен)
APP_URL=http://YOUR_SERVER_IP
APP_NAME="Scooter CRM"

# Laravel APP_KEY — сгенерируйте: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=scooter_crm
MYSQL_USER=scooter
MYSQL_PASSWORD=change_me_db

# Порт HTTP (nginx)
HTTP_PORT=80

# Заполнить БД тестовыми данными при первом деплое (true/false)
SEED_DATABASE=true
